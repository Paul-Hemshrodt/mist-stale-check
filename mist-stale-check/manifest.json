{
  "manifest_version": 3,
  "name": "Mist Stale Check",
  "version": "1.0.0",
  "description": "Warns when the Mist switch page you have open was modified by someone else, so you don't overwrite their changes on Save.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://*.mist.com/*",
        "https://*.mist-federal.com/*"
      ],
      "js": ["content.js"],
      "css": ["banner.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://*.mist.com/*",
    "https://*.mist-federal.com/*"
  ]
}
